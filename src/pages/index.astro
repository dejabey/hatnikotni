---
// src/pages/index.astro
// Halaman Utama Hatnikotni Independent Digital Studio

// Takrifkan data projek utama untuk fleksibiliti
const featuredProjects = [
  {
    title: "Jelajah Perlis",
    tags: ["Travel Guide", "Perlis"],
    description: "Travel guide and local business directory designed to help visitors discover the best of Perlis.",
    image: "/jp-bg.jpg", // Gantian fail imej anda
    linkText: "Visit Jelajah Perlis",
    linkUrl: "#visit-perlis",
  },
  {
    title: "Perlis AI Travel Planner",
    tags: ["AI Powered", "Smart Assistant"],
    description: "An intelligent AI assistant that instantly generates customized per-day itineraries and travel recommendations.",
    image: "/ai-travel-planner-bg.jpg", // Gantian fail imej anda
    linkText: "Try AI Planner",
    linkUrl: "#ai-planner",
  },
];

// Takrifkan data plugin WordPress
const wordpressPlugins = [
  {
    icon: "/icons/chat-icon.svg", // Anda perlu fail ikon atau teks placeholder
    title: "Hatnikotni Chat",
    description: "Lightweight WhatsApp contact routing with consent-aware first-party interaction analytics.",
    linkText: "View Plugin",
    linkUrl: "#chat-plugin",
  },
  {
    icon: "/icons/weather-icon.svg",
    title: "Hatnikotni Jelajah Cuaca",
    description: "WordPress weather and location engine exclusively for Malaysia, using localized weather data and Malaysian location services.",
    linkText: "View Plugin",
    linkUrl: "#weather-plugin",
  },
];
---

<html lang="ms">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HATNIKOTNI | Simple Ideas. Useful Products.</title>
  </head>
  <body>
    <!-- HEADER -->
    <header class="header-container">
      <a href="/" class="logo-link">
        <span class="logo-text">HATNIKOTNI</span>
        <span class="logo-studio">Independent Digital Studio</span>
      </a>
      <nav class="nav-links">
        <a href="#home">Home</a>
        <a href="#logo">Logo</a>
        <a href="#products">Products</a>
        <a href="#contact">Contact</a>
        <a href="#hatnikotni">Hatnikotni</a>
      </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main class="main-content">
      <!-- HERO SECTION -->
      <section class="hero-section">
        <h1 class="hero-title">
          SIMPLE IDEAS.<br />
          <span class="highlight">USEFUL PRODUCTS.</span>
        </h1>
        <p class="hero-intro">
          Hatnikotni creates independent digital products, AI tools, and WordPress plugins that are simple, useful, and built to last.
        </p>
        <div class="hero-buttons">
          <a href="#products" class="btn btn-primary">Explore Products</a>
          <a href="#about" class="btn btn-outline">About Hatnikotni</a>
        </div>
      </section>

      <!-- FEATURED PROJECTS -->
      <section class="projects-section">
        <h2 class="section-title">FEATURED PROJECTS</h2>
        <div class="grid-container projects-grid">
          {
            featuredProjects.map((project) => (
              <div class="card project-card">
                {/* 1. TAGS DI ATAS SEKALI */}
                <div class="tags">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>

                {/* 2. IMEJ */}
                <div class="image-wrapper">
                  <img src={project.image} alt={project.title} class="card-image" />
                  <div class="image-overlay" />
                  {/* 3. TAJUK ATAS SEDIKIT DARI SEMPADAN IMEJ */}
                  <div class="title-overlay-wrapper">
                    <h3 class="card-title">{project.title}</h3>
                  </div>
                </div>

                {/* 4. KETERANGAN PROJEK */}
                <div class="description-wrapper">
                  <p class="card-description">{project.description}</p>
                  <a href={project.linkUrl} class="card-link">{project.linkText} →</a>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- WORDPRESS PLUGINS -->
      <section class="plugins-section">
        <h2 class="section-title">WORDPRESS PLUGINS</h2>
        <div class="grid-container plugins-grid">
          {
            wordpressPlugins.map((plugin) => (
              <div class="card plugin-card">
                <div class="icon-wrapper">
                  {/* Gunakan ikon SVG atau placeholder teks */}
                  <span class="plugin-icon">ICON</span>
                </div>
                <h3 class="card-title">{plugin.title}</h3>
                <p class="card-description">{plugin.description}</p>
                <a href={plugin.linkUrl} class="card-link">{plugin.linkText} →</a>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="footer-container">
      <div class="footer-content">
        <p>&copy; 2026 Hatnikotni Independent Digital Studio. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* =========================================
     1. ASAS & TEMA GELAP
     ========================================= */
  :root {
    --bg-color: #0b0f19; /* Kelabu gelap, seakan visual rujukan */
    --text-muted: #a1aab5;
    --text-light: #ffffff;
    --accent-blue: #0ea5e9;
    --card-bg: #111927;
    --border-color: #1e293b;
  }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-muted);
    /* Corak Grid Latar Belakang Halus */
    background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  /* =========================================
     2. HEADER & NAVIGASI
     ========================================= */
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30px 10%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text-light);
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .logo-studio {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .nav-links {
    display: flex;
    gap: 25px;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .nav-links a:hover {
    color: var(--text-light);
  }

  /* =========================================
     3. KANDUNGAN UTAMA & HERO
     ========================================= */
  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 10% 80px 10%;
  }

  .hero-section {
    margin-bottom: 80px;
  }

  .hero-title {
    font-size: 4rem;
    line-height: 1.1;
    color: var(--text-light);
    margin-top: 20px;
    margin-bottom: 25px;
    letter-spacing: -1px;
  }

  .hero-title .highlight {
    color: var(--accent-blue);
  }

  .hero-intro {
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 40px;
  }

  .hero-buttons {
    display: flex;
    gap: 15px;
  }

  .btn {
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background-color: var(--accent-blue);
    color: #ffffff;
    border: none;
  }

  .btn-primary:hover {
    background-color: #0284c7;
  }

  .btn-outline {
    background-color: transparent;
    color: var(--text-light);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* =========================================
     4. KAD & KANDUNGAN BERSEKSYEN
     ========================================= */
  .content-section {
    margin-bottom: 60px;
  }

  .section-title {
    font-size: 0.9rem;
    letter-spacing: 2px;
    color: var(--accent-blue);
    text-transform: uppercase;
    margin-bottom: 25px;
  }

  .grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 25px;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    transition: transform 0.2s, border-color 0.2s;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: #374151;
  }

  /* REKA LETAK KAD PROJEK (UTAMA) */
  .project-card {
    display: flex;
    flex-direction: column;
  }

  .tags {
    display: flex;
    gap: 10px;
    padding: 20px 30px 0 30px;
    margin-bottom: 1rem;
  }

  .tag {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .image-wrapper {
    position: relative;
    overflow: hidden;
  }

  .card-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 60%, var(--card-bg));
  }

  .title-overlay-wrapper {
    position: absolute;
    bottom: -15px; /* Menurunkan sedikit tajuk menindih imej/keterangan */
    left: 15px;
    right: 15px;
    z-index: 10;
  }

  .description-wrapper {
    padding: 25px 30px 30px 30px;
    margin-top: 1rem; /* Ruang untuk tajuk menindih */
  }

  /* REKA LETAK KAD PLUGIN */
  .plugin-card {
    padding: 30px;
    text-align: center;
  }

  .icon-wrapper {
    margin-bottom: 20px;
  }

  .plugin-icon {
    font-size: 0.8rem;
    font-weight: bold;
    color: var(--accent-blue);
  }

  /* GAYA TEKS KAD UMUM */
  .card h3 {
    color: var(--text-light);
    font-size: 1.3rem;
    margin: 0 0 15px 0;
  }

  .card p {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .card-link {
    color: var(--accent-blue);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  /* =========================================
     5. FOOTER
     ========================================= */
  .footer-container {
    border-top: 1px solid var(--border-color);
    padding: 40px 10%;
    margin-top: 20px;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* =========================================
     6. RESPONSIF / MOBILE VIEW
     ========================================= */
  @media (max-width: 768px) {
    .header-container {
      padding: 20px 5%;
      flex-direction: column;
      gap: 15px;
    }

    .nav-links {
      gap: 15px;
      font-size: 0.85rem;
    }

    .main-content {
      padding: 20px 5% 40px 5%;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .card h3 {
      font-size: 1.15rem;
    }
  }
</style>