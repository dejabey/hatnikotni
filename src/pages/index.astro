---
// src/pages/index.astro
// Halaman Utama Hatnikotni Independent Digital Studio
---

<html lang="ms">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- FAVICON -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <title>Hatnikotni - Independent Digital Studio</title>
  </head>
  <body>
    <!-- HEADER & NAVIGASI -->
    <header class="header-container">
      <a href="#" class="logo-link" id="logoLink">
        <img src="/logo.png" alt="Hatnikotni Logo" class="logo-img" />
      </a>
      
      <nav>
        <ul class="nav-links">
          <li><a href="#projects">Projects</a></li>
          <li><a href="#plugins">Plugins</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <!-- KANDUNGAN UTAMA -->
    <main class="main-content">
      
      <!-- HERO SECTION -->
      <section class="hero-section">
        <h1>SIMPLE IDEAS.<br/><span class="highlight">USEFUL PRODUCTS.</span></h1>
        
        <p class="hero-text">
          Hatnikotni creates independent digital products, AI tools, and WordPress plugins 
          that are simple, useful, and built to last.
        </p>
        
        <div class="hero-buttons">
          <a href="#projects" class="btn btn-primary">Explore Products</a>
          <a href="#about" class="btn btn-outline">About Hatnikotni</a>
        </div>
      </section>

      <!-- FEATURED PROJECTS -->
      <section id="projects" class="content-section">
        <h2 class="section-title">FEATURED PROJECTS</h2>
        <div class="grid-container">
          
          <!-- Card 1: Discover Perlis -->
          <div class="card card-with-image">
            <div class="card-image-container">
              <img src="/jp-bg.jpg" alt="Pemandangan Sawah dan Bukit Perlis" class="card-img" />
              <div class="card-image-overlay"></div>
              
              <div class="card-tags-top">
                <span class="tag tag-overlay">Directory</span>
                <span class="tag tag-overlay">Travel Guide</span>
              </div>
              
              <h3 class="card-title-overlap">Discover Perlis</h3>
            </div>

            <div class="card-body">
              <p>A modern travel guide and local business directory designed to help visitors discover the best of Perlis with confidence.</p>
              <a href="#" class="card-link">Visit Discover Perlis →</a>
            </div>
          </div>

          <!-- Card 2: Perlis AI Travel Planner -->
          <div class="card card-with-image">
            <div class="card-image-container">
              <img src="/ai-travel-planner-bg.jpg" alt="Pelancong menggunakan Perlis AI Travel Planner" class="card-img" />
              <div class="card-image-overlay"></div>
              
              <div class="card-tags-top">
                <span class="tag tag-overlay">AI Powered</span>
                <span class="tag tag-overlay">Smart Assistant</span>
              </div>
              
              <h3 class="card-title-overlap">Perlis AI Travel Planner</h3>
            </div>

            <div class="card-body">
              <p>An intelligent AI assistant that instantly generates customized per-day itineraries and travel recommendations for Perlis visitors.</p>
              <a href="#" class="card-link">Try AI Planner →</a>
            </div>
          </div>

        </div>
      </section>

      <!-- WORDPRESS PLUGINS -->
      <section id="plugins" class="content-section">
        <h2 class="section-title">WORDPRESS PLUGINS</h2>
        <div class="grid-container">
          
          <!-- Card 3: Hatnikotni Chat -->
          <div class="card card-with-image">
            <div class="card-image-container">
              <img src="/chat-bg.jpg" alt="Rangkaian Data Hatnikotni Chat" class="card-img" />
              <div class="card-image-overlay"></div>
              
              <div class="card-tags-top">
                <span class="tag tag-overlay">WordPress</span>
                <span class="tag tag-overlay">WhatsApp Analytics</span>
              </div>
              
              <h3 class="card-title-overlap">Hatnikotni Chat</h3>
            </div>

            <div class="card-body">
              <p>Lightweight WhatsApp contact routing with consent-aware first-party interaction analytics and UTM campaign attribution.</p>
              <a href="#" class="card-link">View Plugin →</a>
            </div>
          </div>

          <!-- Card 4: Hatnikotni Jelajah Cuaca -->
          <div class="card card-with-image">
            <div class="card-image-container">
              <img src="/jelajah-cuaca-bg.jpg" alt="Antara Muka Hatnikotni Jelajah Cuaca" class="card-img" />
              <div class="card-image-overlay"></div>
              
              <div class="card-tags-top">
                <span class="tag tag-overlay">WordPress</span>
                <span class="tag tag-overlay">Malaysia API</span>
              </div>
              
              <h3 class="card-title-overlap">Hatnikotni Jelajah Cuaca</h3>
            </div>

            <div class="card-body">
              <p>WordPress weather and location engine exclusively for Malaysia, using localized weather data and Malaysian location services.</p>
              <a href="#" class="card-link">View Plugin →</a>
            </div>
          </div>

        </div>
      </section>

      <!-- ABOUT & CONTACT SECTION (KINI DUA KOLUM) -->
      <section id="about" class="content-section about-section">
        <h2 class="section-title">ABOUT HATNIKOTNI</h2>
        <div class="card">
          <div class="card-body about-card-body">
            
            <!-- KOLUM KIRI: PENERANGAN RINGKAS -->
            <div class="about-left">
              <h3>Independent Digital Studio</h3>
              <p>
                Hatnikotni is focused on developing clean, efficient, and user-centric digital tools. We believe in software that does exactly what it needs to do without unnecessary bloat.
              </p>
              <p>
                From specialized WordPress plugins that solve local problems to AI-driven applications, our goal is to build products that are truly useful for everyday workflows.
              </p>
            </div>

            <!-- KOLUM KANAN: MEDIA SOSIAL & CONTACT -->
            <div class="about-right" id="contact">
              <h3>Connect & Socials</h3>
              <p class="social-subtitle">Follow our work or reach out for collaborations:</p>
              
              <div class="social-links-grid">
                <!-- GitHub -->
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                  </svg>
                  <span>GitHub</span>
                </a>

                <!-- WordPress.org -->
                <a href="https://wordpress.org" target="_blank" rel="noopener noreferrer" class="social-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M12.607 11.232c.628-.881.996-1.95 1.002-3.097a5.578 5.578 0 0 0-.671-2.68l-2.086 5.713 1.755.064zm-5.748.243 1.536-4.47-1.03-2.983A5.577 5.577 0 0 0 2.45 8.135c0 1.343.473 2.576 1.263 3.543l1.83-5.215 1.316 4.812zm8.006-3.34A7.863 7.863 0 0 0 16 8c0-4.418-3.582-8-8-8S0 3.582 0 8a7.863 7.863 0 0 0 1.135 4.135L8 16l6.865-3.865zM8 1.063c3.832 0 6.937 3.105 6.937 6.937a6.892 6.892 0 0 1-.955 3.498L11.528 4.67c.26-.013.51-.044.51-.044a.438.438 0 0 0-.044-.875s-.76.062-1.25.062c-.468 0-1.229-.062-1.229-.062a.438.438 0 1 0-.044.875s.273.031.5.044l1.621 4.437-2.316 6.945-2.023-6.906c.263-.013.513-.044.513-.044a.438.438 0 0 0-.044-.875s-.76.062-1.25.062c-.468 0-1.229-.062-1.229-.062a.438.438 0 1 0-.044.875s.273.031.5.044l1.983 5.727L4.542 4.67c.26-.013.51-.044.51-.044a.438.438 0 0 0-.044-.875s-.76.062-1.25.062c-.468 0-1.229-.062-1.229-.062a.438.438 0 0 0 0 .875s.273.031.503.044l2.84 8.016A6.908 6.908 0 0 1 1.063 8C1.063 4.168 4.168 1.063 8 1.063z"/>
                  </svg>
                  <span>WordPress.org</span>
                </a>

                <!-- X (Twitter) -->
                <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="social-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M12.6 0h2.454l-5.36 6.126L16 16h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 0h5.063l3.495 4.633L12.6 0zm-.86 14.538h1.36L4.323 1.397H2.863l8.877 13.141z"/>
                  </svg>
                  <span>X (Twitter)</span>
                </a>

                <!-- Direct Contact (Placeholder) -->
                <a href="#" class="social-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                  </svg>
                  <span>Contact Email</span>
                </a>
              </div>
            </div>

          </div>
        </div>
      </section>

    </main>

    <!-- FOOTER -->
    <footer class="footer-container">
      <div class="footer-content">
        <p>&copy; 2026 Hatnikotni Independent Digital Studio. All rights reserved.</p>
      </div>
    </footer>

    <!-- SCROLL TO TOP BUTTON -->
    <button id="scrollToTopBtn" title="Ke atas">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M8 12a.5.5 0 0 0 .5-.5V5.707l2.146 2.147a.5.5 0 0 0 .708-.708l-3-3a.5.5 0 0 0-.708 0l-3 3a.5.5 0 1 0 .708.708L7.5 5.707V11.5a.5.5 0 0 0 .5.5z"/>
      </svg>
    </button>

    <!-- SCRIPT INTERAKTIF (TYPESCRIPT STRICT COMPLIANT) -->
    <script>
      const scrollToTopBtn = document.getElementById("scrollToTopBtn");
      const logoLink = document.getElementById("logoLink");

      // Skrol ke atas bila logo diklik
      if (logoLink) {
        logoLink.addEventListener("click", (e) => {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      // Tunjuk butang bila skrol ke bawah 300px
      window.addEventListener("scroll", () => {
        if (scrollToTopBtn) {
          if (window.scrollY > 300) {
            scrollToTopBtn.classList.add("show");
          } else {
            scrollToTopBtn.classList.remove("show");
          }
        }
      });

      // Skrol ke atas bila butang diklik
      if (scrollToTopBtn) {
        scrollToTopBtn.addEventListener("click", () => {
          window.scrollTo({
            top: 0,
            behavior: "smooth"
          });
        });
      }

      // Smooth scroll untuk pautan navigasi internal
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", function (e: MouseEvent) {
          e.preventDefault();
          const target = e.currentTarget as HTMLAnchorElement | null;
          const targetId = target ? target.getAttribute("href") : null;
          
          if (targetId && targetId !== "#") {
            const targetElement = document.querySelector(targetId);
            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: "smooth"
              });
            }
          }
        });
      });
    </script>
  </body>
</html>

<style>
  /* =========================================
     1. ASAS & PEMBOLEH UBAH
     ========================================= */
  :root {
    --bg-color: #0b0f19;       
    --card-bg: #111927;        
    --text-muted: #9ca3af;     
    --text-light: #f3f4f6;     
    --accent-blue: #0ea5e9;    
    --border-color: #1e293b;   
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-muted);
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    line-height: 1.6;
  }

  /* =========================================
     2. HEADER & LOGO
     ========================================= */
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30px 10%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo-link {
    display: flex;
    align-items: center;
    margin-top: 5px; 
    text-decoration: none;
  }

  .logo-img {
    width: 100%;
    max-width: 180px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 35px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--text-light);
  }

  /* =========================================
     3. HERO SECTION
     ========================================= */
  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 10% 40px 10%;
  }

  .hero-section {
    margin-bottom: 80px;
  }

  .hero-section h1 {
    font-size: 4rem;
    line-height: 1.1;
    color: var(--text-light);
    margin-top: 20px;
    margin-bottom: 25px;
    letter-spacing: -1px;
  }

  .hero-section .highlight {
    color: var(--accent-blue);
  }

  .hero-text {
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 40px;
  }

  .hero-buttons {
    display: flex;
    gap: 15px;
  }

  .btn {
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    text-align: center;
  }

  .btn-primary {
    background-color: var(--accent-blue);
    color: #ffffff;
    border: none;
  }

  .btn-primary:hover {
    background-color: #0284c7;
  }

  .btn-outline {
    background-color: transparent;
    color: var(--text-light);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* =========================================
     4. KAD & KANDUNGAN BERSEKSYEN
     ========================================= */
  .content-section {
    margin-bottom: 80px;
    scroll-margin-top: 100px;
  }

  .section-title {
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    text-transform: uppercase;
    margin-bottom: 25px;
    font-weight: 600;
  }

  .grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 25px;
    align-items: stretch;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: #374151;
  }

  /* REKA LETAK KAD BERIMEJ */
  .card-image-container {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .card:hover .card-img {
    transform: scale(1.05);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 15, 25, 0.5) 0%,
      rgba(11, 15, 25, 0.2) 40%,
      rgba(17, 25, 39, 0.95) 100%
    );
    z-index: 1;
  }

  .card-tags-top {
    position: absolute;
    top: 15px;
    left: 20px;
    right: 20px;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .card-title-overlap {
    position: absolute;
    bottom: 12px;
    left: 20px;
    right: 20px;
    z-index: 10;
    color: var(--text-light);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
    line-height: 1.25;
  }

  .tag {
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tag-overlay {
    background-color: rgba(11, 15, 25, 0.65);
    backdrop-filter: blur(4px);
    color: #e5e7eb;
    border-color: rgba(255, 255, 255, 0.15);
  }

  .card-body {
    padding: 20px 25px 25px 25px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card h3 {
    color: var(--text-light);
    font-size: 1.3rem;
    margin: 0 0 15px 0;
  }

  .card p {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .card-link {
    color: var(--accent-blue);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  /* =========================================
     5. ABOUT & SOCIALS (2-KOLUM SPESIFIK)
     ========================================= */
  .about-card-body {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    padding: 35px;
    align-items: start;
  }

  .about-left p {
    margin-bottom: 12px; 
    line-height: 1.5;   
  }

  .about-left p:last-child {
    margin-bottom: 0;
  }

  .about-right {
    border-left: 1px solid var(--border-color);
    padding-left: 40px;
    scroll-margin-top: 100px;
  }

  .social-subtitle {
    font-size: 0.85rem;
    margin-bottom: 15px !important;
  }

  .social-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 10px;
  }

  .social-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-light);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .social-btn:hover {
    background-color: rgba(14, 165, 233, 0.1);
    border-color: var(--accent-blue);
    color: var(--accent-blue);
  }

  /* =========================================
     6. BUTANG SCROLL TO TOP
     ========================================= */
  #scrollToTopBtn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background-color: var(--card-bg);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    border-radius: 50%;
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s, background-color 0.3s, color 0.3s;
    z-index: 1000;
    box-shadow: 0 4px 6px rgba(0,0,0,0.3);
  }

  #scrollToTopBtn.show {
    opacity: 1;
    visibility: visible;
  }

  #scrollToTopBtn:hover {
    background-color: var(--accent-blue);
    color: white;
    border-color: var(--accent-blue);
  }

  /* =========================================
     7. FOOTER
     ========================================= */
  .footer-container {
    border-top: 1px solid var(--border-color);
    padding: 40px 10%;
    margin-top: 20px;
    background-color: rgba(11, 15, 25, 0.8);
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* =========================================
     8. RESPONSIF / MOBILE VIEW (< 768px)
     ========================================= */
  @media (max-width: 768px) {
    .header-container {
      padding: 25px 5%;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .logo-img {
      max-width: 140px; 
    }

    .nav-links {
      width: 100%;
      flex-direction: row;
      justify-content: center;
      gap: 20px;
    }

    .main-content {
      padding: 20px 5% 40px 5%;
    }

    .hero-section h1 {
      font-size: 2.5rem;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      box-sizing: border-box;
    }

    .card-title-overlap {
      font-size: 1.2rem;
    }

    .about-card-body {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 25px;
    }

