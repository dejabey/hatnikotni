---
// src/pages/index.astro
// Halaman Utama Hatnikotni
---

<html lang="ms">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- FAVICON (Gunakan logo.png dari folder /public) -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <title>Hatnikotni - Independent Digital Studio</title>
  </head>
  <body>
    <!-- HEADER & NAVIGASI -->
    <header class="header-container">
      <a href="/" class="logo-link">
        <img src="/logo.png" alt="Hatnikotni Logo" class="logo-img" />
      </a>
      
      <nav>
        <ul class="nav-links">
          <li><a href="#projects">Projects</a></li>
          <li><a href="#plugins">Plugins</a></li>
          <li><a href="#about">About</a></li>
        </ul>
      </nav>
    </header>

    <!-- KANDUNGAN UTAMA -->
    <main class="main-content">
      
      <!-- HERO SECTION -->
      <section class="hero-section">
        <h1>SIMPLE IDEAS.<br/><span class="highlight">USEFUL PRODUCTS.</span></h1>
        
        <p class="hero-text">
          Hatnikotni creates independent digital products, AI tools, and WordPress plugins 
          that are simple, useful, and built to last.
        </p>
        
        <div class="hero-buttons">
          <a href="#projects" class="btn btn-primary">Explore Products</a>
          <a href="#about" class="btn btn-outline">About Hatnikotni</a>
        </div>
      </section>

      <!-- FEATURED PROJECTS -->
      <section id="projects" class="content-section">
        <h2 class="section-title">FEATURED PROJECTS</h2>
        <div class="grid-container">
          
          <!-- Card 1: Discover Perlis (Tags & Tajuk Overlay di Atas Imej) -->
          <div class="card card-with-image">
            <div class="card-image-container">
              <img src="/jp-bg.jpg" alt="Pemandangan Sawah dan Bukit Perlis" class="card-img" />
              <!-- Lapisan Gelap untuk Keterangan Teks Jelas -->
              <div class="card-image-overlay"></div>
              
              <!-- Kandungan Atas Imej (Tags di Puncak, Tajuk di Sempadan Bawah Imej) -->
              <div class="card-header-overlay">
                <div class="card-tags">
                  <span class="tag tag-overlay">Directory</span>
                  <span class="tag tag-overlay">Travel Guide</span>
                </div>
                <h3 class="overlay-title">Discover Perlis</h3>
              </div>
            </div>

            <div class="card-body">
              <p>A modern travel guide and local business directory designed to help visitors discover the best of Perlis with confidence.</p>
              <a href="#" class="card-link">Visit Discover Perlis →</a>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="card">
            <div class="card-body">
              <div class="card-tags">
                <span class="tag">AI Powered</span>
                <span class="tag">Smart Assistant</span>
              </div>
              <h3>Perlis AI Travel Planner</h3>
              <p>An intelligent AI assistant that instantly generates customized per-day itineraries and travel recommendations for Perlis visitors.</p>
              <a href="#" class="card-link">Try AI Planner →</a>
            </div>
          </div>

        </div>
      </section>

      <!-- WORDPRESS PLUGINS -->
      <section id="plugins" class="content-section">
        <h2 class="section-title">WORDPRESS PLUGINS</h2>
        <div class="grid-container">
          
          <!-- Card 3 -->
          <div class="card">
            <div class="card-body">
              <div class="card-tags">
                <span class="tag">WordPress</span>
                <span class="tag">WhatsApp Analytics</span>
              </div>
              <h3>Hatnikotni Chat</h3>
              <p>Lightweight WhatsApp contact routing with consent-aware first-party interaction analytics and UTM campaign attribution.</p>
              <a href="#" class="card-link">View Plugin →</a>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="card">
            <div class="card-body">
              <div class="card-tags">
                <span class="tag">WordPress</span>
                <span class="tag">Malaysia API</span>
              </div>
              <h3>Hatnikotni Jelajah Cuaca</h3>
              <p>WordPress weather and location engine exclusively for Malaysia, using localized weather data and Malaysian location services.</p>
              <a href="#" class="card-link">View Plugin →</a>
            </div>
          </div>

        </div>
      </section>

      <!-- ABOUT SECTION -->
      <section id="about" class="content-section about-section">
        <h2 class="section-title">ABOUT HATNIKOTNI</h2>
        <div class="card">
          <div class="card-body about-content">
            <h3>Independent Digital Studio</h3>
            <p>
              Hatnikotni is focused on developing clean, efficient, and user-centric digital tools. We believe in software that does exactly what it needs to do without unnecessary bloat.
            </p>
            <p>
              From specialized WordPress plugins that solve local problems to AI-driven applications, our goal is to build products that are truly useful for everyday workflows.
            </p>
          </div>
        </div>
      </section>

    </main>

    <!-- FOOTER -->
    <footer class="footer-container">
      <div class="footer-content">
        <p>&copy; 2026 Hatnikotni Independent Digital Studio. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* =========================================
     1. ASAS & PEMBOLEH UBAH
     ========================================= */
  :root {
    --bg-color: #0b0f19;       /* Latar gelap utama tapak web */
    --card-bg: #111927;        /* Warna latar kad (biru kelabu gelap) */
    --text-muted: #9ca3af;     /* Warna teks perenggan */
    --text-light: #f3f4f6;     /* Warna teks putih tajuk */
    --accent-blue: #0ea5e9;    /* Warna biru highlight */
    --border-color: #1e293b;   /* Warna garisan sempadan kad */
  }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-muted);
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    line-height: 1.6;
  }

  /* =========================================
     2. HEADER & LOGO (DESKTOP)
     ========================================= */
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30px 10%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo-link {
    display: flex;
    align-items: center;
    margin-top: 5px; 
  }

  .logo-img {
    width: 100%;
    max-width: 180px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 35px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--text-light);
  }

  /* =========================================
     3. KANDUNGAN UTAMA & HERO
     ========================================= */
  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 10% 40px 10%;
  }

  .hero-section {
    margin-bottom: 80px;
  }

  .hero-section h1 {
    font-size: 4rem;
    line-height: 1.1;
    color: var(--text-light);
    margin-top: 20px;
    margin-bottom: 25px;
    letter-spacing: -1px;
  }

  .hero-section .highlight {
    color: var(--accent-blue);
  }

  .hero-text {
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 40px;
  }

  .hero-buttons {
    display: flex;
    gap: 15px;
  }

  .btn {
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    text-align: center;
  }

  .btn-primary {
    background-color: var(--accent-blue);
    color: #ffffff;
    border: none;
  }

  .btn-primary:hover {
    background-color: #0284c7;
  }

  .btn-outline {
    background-color: transparent;
    color: var(--text-light);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* =========================================
     4. KAD & KANDUNGAN BERSEKSYEN
     ========================================= */
  .content-section {
    margin-bottom: 80px;
  }

  .section-title {
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    text-transform: uppercase;
    margin-bottom: 25px;
    font-weight: 600;
  }

  .grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 25px;
    align-items: stretch;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: #374151;
  }

  /* REKA LETAK OVERLAY IMEJ KAD DISCOVER PERLIS */
  .card-image-container {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .card:hover .card-img {
    transform: scale(1.05);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 15, 25, 0.75) 0%,
      rgba(11, 15, 25, 0.2) 40%,
      rgba(17, 25, 39, 0.95) 100%
    );
    z-index: 1;
  }

  .card-header-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .overlay-title {
    color: var(--text-light);
    font-size: 1.35rem;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .card-body {
    padding: 25px 30px 30px 30px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-tags {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
  }

  .tag {
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tag-overlay {
    background-color: rgba(11, 15, 25, 0.6);
    backdrop-filter: blur(4px);
    color: #e5e7eb;
    border-color: rgba(255, 255, 255, 0.15);
  }

  .card h3 {
    color: var(--text-light);
    font-size: 1.3rem;
    margin: 0 0 15px 0;
  }

  .card p {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .card-link {
    color: var(--accent-blue);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .about-content p {
    margin-bottom: 15px;
  }
  
  .about-content p:last-child {
    margin-bottom: 0;
  }

  /* =========================================
     5. FOOTER
     ========================================= */
  .footer-container {
    border-top: 1px solid var(--border-color);
    padding: 40px 10%;
    margin-top: 20px;
    background-color: rgba(11, 15, 25, 0.8);
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* =========================================
     6. RESPONSIF / MOBILE VIEW (< 768px)
     ========================================= */
  @media (max-width: 768px) {
    .header-container {
      padding: 25px 5%;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .logo-img {
      max-width: 140px; 
    }

    .nav-links {
      width: 100%;
      flex-direction: row;
      justify-content: center;
      gap: 25px;
    }

    .main-content {
      padding: 20px 5% 40px 5%;
    }

    .hero-section h1 {
      font-size: 2.5rem;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>