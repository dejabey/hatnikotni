---
// src/pages/index.astro
// Halaman Utama Hatnikotni
---

<html lang="ms">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hatnikotni - Independent Digital Studio</title>
  </head>
  <body>
    <!-- HEADER & NAVIGASI -->
    <header class="header-container">
      <a href="/" class="logo-link">
        <!-- Logo akan diambil dari folder /public -->
        <img src="/logo.png" alt="Hatnikotni Logo" class="logo-img" />
      </a>
      
      <nav>
        <ul class="nav-links">
          <li><a href="#projects">Projects</a></li>
          <li><a href="#plugins">Plugins</a></li>
          <li><a href="#about">About</a></li>
        </ul>
      </nav>
    </header>

    <!-- KANDUNGAN UTAMA -->
    <main class="main-content">
      <section class="hero-section">
        <h1>SIMPLE IDEAS.<br/><span class="highlight">USEFUL PRODUCTS.</span></h1>
        
        <p class="hero-text">
          Hatnikotni creates independent digital products, AI tools, and WordPress plugins 
          that are simple, useful, and built to last.
        </p>
        
        <div class="hero-buttons">
          <a href="#projects" class="btn btn-primary">Explore Products</a>
          <a href="#about" class="btn btn-outline">About Hatnikotni</a>
        </div>
      </section>
      
      <!-- Anda boleh masukkan komponen bahagian Kad Projek di bawah ini nanti -->
    </main>
  </body>
</html>

<style>
  /* =========================================
     1. ASAS & PEMBOLEH UBAH
     ========================================= */
  :root {
    --bg-color: #0d1117;       /* Latar gelap charcoal */
    --text-muted: #8b949e;     /* Teks kelabu */
    --text-light: #ffffff;     /* Teks putih */
    --accent-blue: #0099ff;    /* Warna butang dan highlight */
  }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-muted);
    /* Corak Grid Latar Belakang */
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  /* =========================================
     2. HEADER & LOGO (SUSUNAN BENTUK DESKTOP)
     ========================================= */
  .header-container {
    display: flex;
    justify-content: space-between; /* Asingkan logo ke kiri, menu ke kanan */
    align-items: center;
    padding: 30px 10%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo-img {
    width: 100%;
    max-width: 200px; /* Saiz optimal Desktop */
    height: auto;
    object-fit: contain;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 30px; /* Jarak mendatar antara teks menu */
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--text-light);
  }

  /* =========================================
     3. KANDUNGAN HERO
     ========================================= */
  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 10%;
  }

  .hero-section h1 {
    font-size: 4rem;
    line-height: 1.1;
    color: var(--text-light);
    margin-top: 20px;
    margin-bottom: 25px;
    letter-spacing: -1px;
  }

  .hero-section .highlight {
    color: var(--accent-blue);
  }

  .hero-text {
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 550px;
    margin-bottom: 40px;
  }

  .hero-buttons {
    display: flex;
    gap: 15px;
  }

  .btn {
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .btn-primary {
    background-color: var(--accent-blue);
    color: #ffffff;
    border: none;
  }

  .btn-primary:hover {
    background-color: #007acc;
  }

  .btn-outline {
    background-color: transparent;
    color: var(--text-light);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* =========================================
     4. RESPONSIF / MOBILE VIEW (< 768px)
     ========================================= */
  @media (max-width: 768px) {
    .header-container {
      padding: 20px 5%;
      flex-direction: column; /* Ubah susunan dari melintang ke menegak */
      align-items: flex-start; /* Tolak semua ke kiri */
      gap: 20px;
    }

    .logo-img {
      max-width: 130px; /* Kecilkan saiz logo di mobile supaya tidak makan ruang */
    }

    .nav-links {
      width: 100%;
      flex-direction: row; /* Kekalkan menu melintang di bawah logo */
      justify-content: flex-start;
      gap: 20px;
      font-size: 0.95rem;
    }

    .main-content {
      padding: 20px 5%;
    }

    .hero-section h1 {
      font-size: 2.5rem; /* Kecilkan saiz tajuk utama di mobile */
    }

    .hero-buttons {
      flex-direction: column; /* Susun butang atas dan bawah di skrin kecil */
    }

    .btn {
      text-align: center;
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>